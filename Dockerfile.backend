# Dockerfile.backend
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System deps – adjust if your requirements.txt needs more
# (cv2 typically needs these)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (better layer caching)
COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

# Copy the actual app
COPY elongation_rebar ./elongation_rebar
COPY process_video.py .
COPY sample ./sample

# Make sure results/uploads dirs exist
RUN mkdir -p results uploads

EXPOSE 8000

# Same as your `runserver` target, but without --reload in prod
CMD ["uvicorn", "elongation_rebar.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
